{
  "name": "omer-mamad-planner",
  "version": "0.1.0",
  "private": true,
  "description": "מערכת תכנון ממ״ד · התקן עומר — ממשק לקוח + שרת API (סליקה, דוא״ל, העלאת שרטוטי DWG)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "nodemailer": "^6.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}

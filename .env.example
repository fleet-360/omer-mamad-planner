# Copy to .env and fill in. Everything works without it in demo mode (mock payments, console email).

# ---- app
API_PORT=8787
APP_URL=http://localhost:5173
# public URL the payment provider can reach for webhooks (e.g. https://app.example.co.il)
API_PUBLIC_URL=http://localhost:8787
AUTH_SECRET=change-me-to-a-long-random-string
# true = login accepts any email/password (for client demos). Set false in production.
AUTH_DEMO=true

# ---- storage
# Supabase (required on Vercel). Project Settings -> API: URL + service_role key (server only, never in VITE_*).
# Run supabase/schema.sql once. Empty = local JSON file + uploads/ folder (demo mode).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=drawings
DATA_DIR=data
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=80

# ---- plans (monthly, ILS, before VAT). Empty = not decided yet ("—" in the design)
VAT_RATE=0.18
PLAN_PRICE_BASIC=
PLAN_PRICE_PRO=
PLAN_PRICE_OFFICE=

# ---- payments: mock | grow | cardcom
PAYMENT_PROVIDER=mock

# Grow (Meshulam) — sandbox URL by default; production: the URL Grow provides with the account
GROW_API_URL=https://sandbox.meshulam.co.il/api/light/server/1.0
GROW_PAGE_CODE=
GROW_USER_ID=
GROW_API_KEY=

# Cardcom
CARDCOM_API_URL=https://secure.cardcom.solutions/api/v11
CARDCOM_TERMINAL=
CARDCOM_API_NAME=

# ---- email: console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM=מערכת תכנון ממ״ד <no-reply@example.co.il>
# office inbox that receives a copy of every new project and payment
NOTIFY_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=
